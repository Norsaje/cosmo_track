FROM nginx:1.27-alpine

# MapLibre скачивается в образ, а не подключается из CDN. Причина не в скорости:
# страница открывается с чужой машины, и у браузера пользователя доступа к unpkg.com
# может не быть — тогда карта не появляется при полностью исправном сервере, что
# и произошло на демо. Сервер отдаёт библиотеку сам, и подложка зависит только от
# доступности нашего стенда.
#
# SHA256 проверяется: скачивание в сборку без проверки — это молчаливое доверие
# к чужому CDN, и подмена файла прошла бы незамеченной.
ARG MAPLIBRE_VERSION=4.7.1
ARG MAPLIBRE_JS_SHA256=be9633c4d870e26fb37f1cfe5c5a77181667114003ea16207ac7850d8da8add1
ARG MAPLIBRE_CSS_SHA256=576b085fdd9487a65a19215328c1e086c07ce5bf6da09b666b3806d3d008dae9

RUN apk add --no-cache curl \
    && mkdir -p /usr/share/nginx/html/vendor \
    && curl -fsSL "https://unpkg.com/maplibre-gl@${MAPLIBRE_VERSION}/dist/maplibre-gl.js" \
         -o /usr/share/nginx/html/vendor/maplibre-gl.js \
    && curl -fsSL "https://unpkg.com/maplibre-gl@${MAPLIBRE_VERSION}/dist/maplibre-gl.css" \
         -o /usr/share/nginx/html/vendor/maplibre-gl.css \
    && echo "${MAPLIBRE_JS_SHA256}  /usr/share/nginx/html/vendor/maplibre-gl.js" | sha256sum -c - \
    && echo "${MAPLIBRE_CSS_SHA256}  /usr/share/nginx/html/vendor/maplibre-gl.css" | sha256sum -c - \
    && apk del curl

COPY apps/web/index.html /usr/share/nginx/html/index.html
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf

# Non-root (§8.11 ТЗ). Три вещи, без которых nginx под непривилегированным
# пользователем не стартует, и каждая ловится только фактическим запуском:
#   1. порт 8080 вместо 80 — порты ниже 1024 недоступны;
#   2. pid-файл в /tmp — в образе он объявлен как /run/nginx.pid, куда uid 101 не пишет
#      (директива именно `pid`, путь без /var — подстановка идёт по имени директивы,
#      а не по literal-пути, иначе замена молча не срабатывает);
#   3. каталоги кэша и временных файлов, принадлежащие nginx.
RUN sed -i 's|^pid .*;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf \
    && sed -i 's|^user .*;|# user: контейнер уже работает под nginx|' /etc/nginx/nginx.conf \
    && mkdir -p /var/cache/nginx/client_temp /var/cache/nginx/proxy_temp /var/cache/nginx/tiles \
    && chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /etc/nginx/conf.d
USER nginx

EXPOSE 8080
