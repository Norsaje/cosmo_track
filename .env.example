# Только placeholder-ы. Реальные значения живут в .env, который в git не попадает
# (инвариант 11). Ни один секрет не запекается в образ.

# --- Postgres + PostGIS ---
POSTGRES_USER=cosmo
POSTGRES_PASSWORD=change-me   # обязателен: compose откажется стартовать без него
POSTGRES_DB=cosmo
# Переменные самого приложения читаются с префиксом COSMO_ — так конфигурация
# сервиса не подхватывается случайно из окружения CI-раннера.
COSMO_DATABASE_URL=postgresql+psycopg://cosmo:change-me@postgres:5432/cosmo

# --- Redis ---
COSMO_REDIS_URL=redis://redis:6379/0

# --- Модель (каталог model/, монтируется read-only) ---
# Внутри: ndvi/ (код инференса), data/ (train.csv и test_features.csv) и runs/ с
# обученной смесью. Пакет самодостаточен и хеширован PACKAGE_MANIFEST.json,
# поэтому монтируется как есть и не копируется в образ.
COSMO_MODEL_PACKAGE_PATH=/srv/model
# Ряды для offline-источника берутся из данных самой поставки: сервис обязан
# отдавать ровно те полигоны, на которых обучалась модель.
COSMO_MODEL_DATA_DIR=/srv/model/data
# Имя обученного запуска внутри model/runs/. Kaggle-прогон приедет соседним каталогом,
# и переключение на него не должно требовать пересборки образа.
COSMO_MODEL_RUN_NAME=local
# Путь на хосте, который монтируется в COSMO_MODEL_PACKAGE_PATH.
MODEL_PACKAGE_HOST_PATH=./model
# development | production. В production заглушка ModelStub запрещена и старт падает,
# если COSMO_ALLOW_MODEL_STUB не выключен явно.
COSMO_ENVIRONMENT=development
COSMO_ALLOW_MODEL_STUB=true
# Обученная смесь лежит в pickle, а pickle исполняет код при загрузке. Доверие
# включается осознанно: SHA256 из PACKAGE_MANIFEST.json ловит порчу файла, но не
# подлог автора. Для поставки model/ включено после сверки хешей и воспроизведения
# submission.csv байт в байт.
COSMO_MODEL_BUNDLE_TRUSTED=true

# --- Вход через Braining ID (id.braining.space) ---
# Приложение регистрируется в Braining ID, оттуда берутся client_id и secret.
# Пустые значения означают «вход не настроен»: сервис честно отвечает 503,
# а интерфейс показывает это словами вместо неработающей кнопки.
COSMO_BRAINING_ID_URL=https://id.braining.space
COSMO_BRAINING_ID_CLIENT_ID=
COSMO_BRAINING_ID_CLIENT_SECRET=
# Срок жизни сессии в днях. Больше — реже входить, но и украденная cookie
# живёт дольше.
COSMO_SESSION_TTL_DAYS=30
# Secure-флаг cookie. На стенде с TLS включать обязательно; по умолчанию
# выключен, потому что стенд поднимается и по http на localhost.
COSMO_SESSION_COOKIE_SECURE=true

# --- CORS: перечислить origin-ы явно, "*" в проде запрещена ---
# Формат — JSON-массив (требование pydantic-settings), не CSV.
COSMO_CORS_ORIGINS=["http://localhost:8080"]

# --- Провайдеры (BE-007/BE-009). Пусто = провайдер not_configured, демо работает на кэше ---
GEE_SERVICE_ACCOUNT_JSON=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSAPI_URL=
CDSAPI_KEY=
