# Только placeholder-ы. Реальные значения живут в .env, который в git не попадает
# (инвариант 11). Ни один секрет не запекается в образ.

# --- Postgres + PostGIS ---
POSTGRES_USER=cosmo
POSTGRES_PASSWORD=change-me   # обязателен: compose откажется стартовать без него
POSTGRES_DB=cosmo
# Переменные самого приложения читаются с префиксом COSMO_ — так конфигурация
# сервиса не подхватывается случайно из окружения CI-раннера.
COSMO_DATABASE_URL=postgresql+psycopg://cosmo:change-me@postgres:5432/cosmo

# --- Redis ---
COSMO_REDIS_URL=redis://redis:6379/0

# --- Model bundle от Разработчика 1 (монтируется read-only) ---
COSMO_MODEL_BUNDLE_PATH=/srv/model_bundle
# Путь на хосте, который монтируется в MODEL_BUNDLE_PATH. По умолчанию — заглушка
# infra/model_bundle; после handoff C-04 указать ./artifacts/ml/final_bundle
MODEL_BUNDLE_HOST_PATH=./infra/model_bundle

# --- CORS: перечислить origin-ы явно, "*" в проде запрещена ---
# Формат — JSON-массив (требование pydantic-settings), не CSV.
COSMO_CORS_ORIGINS=["http://localhost:8080"]

# --- Провайдеры (BE-007/BE-009). Пусто = провайдер not_configured, демо работает на кэше ---
GEE_SERVICE_ACCOUNT_JSON=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSAPI_URL=
CDSAPI_KEY=
